# 应用配置
APP_NAME=Wiki 知识库后端
APP_VERSION=0.1.0
# 服务监听配置
HOST=0.0.0.0
PORT=8000
# 允许跨域的前端地址
CORS_ORIGINS=["http://localhost:3000"]
# 数据库地址（SQLite，阶段 1）
DATABASE_URL=sqlite:///./wiki.db

# ===== 大模型 API Key 加密密钥 =====
# 用于加密存储模型配置中的 API Key。生产环境必须设置一个足够随机的值；
# 未配置时后端会从 JWT_SECRET 派生（仅便于开发/测试，切勿用于生产）。
MODEL_API_KEY_SECRET=please-change-me-to-a-long-random-string

# JWT 预留配置（后续认证阶段使用）
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# ===== 文档处理任务后台 =====
# 是否启用后台任务处理器（默认启用；测试环境通常关闭，改为手动触发）
WORKER_ENABLED=true
# 单任务最大执行次数（含重试）
TASK_MAX_ATTEMPTS=3
# 超过该时长仍处于 processing 视为中断（秒），服务重启时自动恢复为失败
TASK_PROCESSING_TIMEOUT=300
